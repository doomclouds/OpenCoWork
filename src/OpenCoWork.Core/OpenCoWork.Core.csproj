<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Tiktoken" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenCoWork.Abstractions\OpenCoWork.Abstractions.csproj" />
    <ProjectReference Include="..\OpenCoWork.Generators\OpenCoWork.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Agents\Tokenizers\*.json.gz"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="tokenizers\%(Filename)%(Extension)" />
    <None Update="Agents\Tokenizers\NOTICE.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="tokenizers\NOTICE.md" />
  </ItemGroup>
</Project>
